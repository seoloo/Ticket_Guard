DJANGO_SECRET_KEY=local-demo-only-change-before-deployment-ticket-guard
DEMO_USERNAME=ticketguard
DEMO_SECOND_USERNAME=guest
DEMO_PASSWORD=ticketguard-demo
SHOW_SCENARIOS=1
# QA 테스트 훅 · DJANGO_DEBUG=1일 때만 · 비어 있으면 꺼짐 (Issue #6)
QUEUE_WAIT_SECONDS=12
# Global booking admission: up to 40 entries per 5-second window.
BOOKING_ADMISSION_BATCH_SIZE=40
BOOKING_ADMISSION_INTERVAL_SECONDS=5
QA_TEST_ACCOUNT_COUNT=0
QA_TEST_ACCOUNT_PASSWORD=
QA_CAPTCHA_FIXED_ANSWER=
QA_RESET_ENABLED=0
EVENT_PUBLISHER=kafka
KAFKA_EVENTS_TOPIC=ticketguard.events.v1
# Development replay proposal (7 days), pending review of original 24-hour policy.
KAFKA_RETENTION_MS=604800000
# Per partition 256 MiB; 3 partitions about 768 MiB plus segment overhead.
KAFKA_RETENTION_BYTES=268435456
# Keep stable while retaining kafka-data.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# MongoDB only; replace all placeholders in ignored .env before starting.
MONGO_ROOT_USERNAME=CHANGE_ME_ADMIN_USERNAME
MONGO_ROOT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
MONGO_WRITER_USERNAME=CHANGE_ME_WRITER_USERNAME
MONGO_WRITER_PASSWORD=CHANGE_ME_WRITER_PASSWORD
# Optional: leave BOTH empty for the default writer-only setup.
MONGO_ADMIN_READER_USERNAME=
MONGO_ADMIN_READER_PASSWORD=
MONGO_DATABASE=ticketguard
# Local host port for Compass; Docker-internal MongoDB remains on 27017.
MONGO_HOST_PORT=27017
# QA dashboard read-only URI; configure locally, never commit credentials.
TICKET_GUARD_QA_SYSTEM_MONGO_URI=
# Optional compose.qa-db-access.yml: same read account/DB as the dashboard URI.
# URL-encode user/password in URIs. Do not use writer/root credentials here.
# TICKET_GUARD_QA_SYSTEM_MONGO_URI=mongodb://ticketguard_admin_reader:ENCODED_PASSWORD@ticket-guard-workspace-db-mongo-1:27017/ticketguard?authSource=ticketguard
TICKET_GUARD_QA_SYSTEM_RAW_MONGO_URI=
# Example: mongodb://raw_reader:ENCODED_PASSWORD@ticket-guard-raw-mongo-raw-1:27020/ticketguard_raw?authSource=ticketguard_raw
TICKET_GUARD_QA_SYSTEM_RAW_SOURCE_ID=
# Optional QA verification: use the RAW_SOURCE_ID below, not writer credentials.
TICKET_GUARD_QA_RAW_MONGO_NETWORK=ticket-guard-raw_raw-backend

# Spark only: explicit profile and ticket-guard-workspace-pipeline project.
SPARK_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPARK_KAFKA_GROUP_ID=ticketguard-spark-consumer
SPARK_KAFKA_NETWORK=ticket-guard_default
SPARK_MONGO_NETWORK=ticket-guard-workspace-db_mongo-backend
# Do not use the ambiguous mongo alias on a multi-network Spark container.
SPARK_MONGO_HOST=ticket-guard-workspace-db-mongo-1
SPARK_MONGO_PORT=27017
SPARK_CHECKPOINT_DIR=/checkpoints/spark-consumer
SPARK_TRIGGER_SECONDS=5
SPARK_MAX_OFFSETS_PER_TRIGGER=1000
SPARK_MONGO_BULK_SIZE=200
SPARK_MONGO_TIMEOUT_MS=10000
SPARK_MONGO_WRITE_ATTEMPTS=3
# 관리자 · 로그인하면 QA 대시보드(/qa/)로 이동 · 개발용 공개 값 · 팀 입구(compose.gateway.yml)와 함께 사용
DEMO_ADMIN_USERNAME=manager
## DB 관리자 앱 · 시스템 DB URI · QA 연결 설정과 분리
# Default local setup: use MONGO_WRITER_USERNAME/PASSWORD and MONGO_DATABASE.
# URL-encode credentials; setting a URI does not create another DB user.
# This hostname is the DB project container, not the PC's localhost/host port.
TICKET_GUARD_ADMIN_MONGO_URI=
# Example: mongodb://ENCODED_WRITER_USERNAME:ENCODED_WRITER_PASSWORD@ticket-guard-workspace-db-mongo-1:27017/ticketguard?authSource=ticketguard
TICKET_GUARD_ADMIN_MONGO_NETWORK=ticket-guard-workspace-db_mongo-backend
DEMO_ADMIN_PASSWORD=manager

# QA-owned database, required when adding qa/compose.qa-db.yml.
# Keep QA passwords alphanumeric; its Compose constructs the URI directly.
QA_MONGO_DATABASE=ticketguard_qa
QA_MONGO_ROOT_USERNAME=CHANGE_ME_QA_ADMIN
QA_MONGO_ROOT_PASSWORD=CHANGE_ME_QA_ADMIN_PASSWORD
QA_MONGO_USERNAME=CHANGE_ME_QA_WRITER
QA_MONGO_PASSWORD=CHANGE_ME_QA_WRITER_PASSWORD
QA_MONGO_HOST_PORT=27021

# Raw ingestion: use this root .env, no separate raw_consumer/.env required.
RAW_SOURCE_ID=ticketguard-dev-generation-1
RAW_KAFKA_NETWORK=ticket-guard_default
RAW_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
RAW_KAFKA_TOPIC=ticketguard.events.v1
RAW_KAFKA_GROUP_ID=ticketguard-raw-db-v1
RAW_MONGO_DATABASE=ticketguard_raw
RAW_MONGO_ROOT_USERNAME=CHANGE_ME_RAW_ADMIN
RAW_MONGO_ROOT_PASSWORD=CHANGE_ME_RAW_ADMIN_PASSWORD
RAW_MONGO_WRITER_USERNAME=CHANGE_ME_RAW_WRITER
RAW_MONGO_WRITER_PASSWORD=CHANGE_ME_RAW_WRITER_PASSWORD
# Optional reader: leave BOTH empty for writer-only ingestion and Compass.
RAW_MONGO_READER_USERNAME=
RAW_MONGO_READER_PASSWORD=
RAW_BATCH_MAX_MESSAGES=200
RAW_BATCH_WAIT_SECONDS=1
RAW_BATCH_MAX_BYTES=4194304
RAW_BATCH_WRITE_SECONDS=35
# Fixed routing contract; do not change for an existing group.
RAW_ROUTING_FINGERPRINT=54e2a7c73316ed633ef5a445ff9dc0b87b44cd302b8af93f8c9cce586f6f8b1b
