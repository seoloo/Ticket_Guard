DJANGO_SECRET_KEY=local-demo-only-change-before-deployment-ticket-guard
DEMO_USERNAME=ticketguard
DEMO_SECOND_USERNAME=guest
DEMO_PASSWORD=ticketguard-demo
SHOW_SCENARIOS=1
# QA 테스트 훅 · DJANGO_DEBUG=1일 때만 · 비어 있으면 꺼짐 (Issue #6)
QUEUE_WAIT_SECONDS=12
QA_TEST_ACCOUNT_COUNT=0
QA_TEST_ACCOUNT_PASSWORD=
QA_CAPTCHA_FIXED_ANSWER=
QA_RESET_ENABLED=0
EVENT_PUBLISHER=kafka
KAFKA_EVENTS_TOPIC=ticketguard.events.v1
# Development replay proposal (7 days), pending review of original 24-hour policy.
KAFKA_RETENTION_MS=604800000
# Per partition 256 MiB; 3 partitions about 768 MiB plus segment overhead.
KAFKA_RETENTION_BYTES=268435456
# Keep stable while retaining kafka-data.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# MongoDB only; replace all placeholders in ignored .env before starting.
MONGO_ROOT_USERNAME=CHANGE_ME_ADMIN_USERNAME
MONGO_ROOT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
MONGO_WRITER_USERNAME=CHANGE_ME_WRITER_USERNAME
MONGO_WRITER_PASSWORD=CHANGE_ME_WRITER_PASSWORD
MONGO_DATABASE=ticketguard
# Local host port for Compass; Docker-internal MongoDB remains on 27017.
MONGO_HOST_PORT=27017
# QA dashboard read-only URI; configure locally, never commit credentials.
TICKET_GUARD_QA_SYSTEM_MONGO_URI=

# Spark only: explicit profile and ticket-guard-workspace-pipeline project.
SPARK_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPARK_KAFKA_GROUP_ID=ticketguard-spark-consumer
SPARK_KAFKA_NETWORK=ticket-guard_default
SPARK_MONGO_NETWORK=ticket-guard-workspace-db_mongo-backend
# Do not use the ambiguous mongo alias on a multi-network Spark container.
SPARK_MONGO_HOST=ticket-guard-workspace-db-mongo-1
SPARK_MONGO_PORT=27017
SPARK_CHECKPOINT_DIR=/checkpoints/spark-consumer
SPARK_TRIGGER_SECONDS=5
SPARK_MAX_OFFSETS_PER_TRIGGER=1000
SPARK_MONGO_BULK_SIZE=200
SPARK_MONGO_TIMEOUT_MS=10000
SPARK_MONGO_WRITE_ATTEMPTS=3
# 관리자 · 로그인하면 QA 대시보드(/qa/)로 이동 · 개발용 공개 값 · 팀 입구(compose.gateway.yml)와 함께 사용
DEMO_ADMIN_USERNAME=manager
## DB 관리자 앱 전용 · 시스템 DB의 read 권한 계정 · QA 연결 설정과 분리
TICKET_GUARD_ADMIN_MONGO_URI=
TICKET_GUARD_ADMIN_MONGO_NETWORK=ticket-guard-workspace-db_mongo-backend
DEMO_ADMIN_PASSWORD=manager
