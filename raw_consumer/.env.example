# [홍석환] 원본 적재 환경변수 예시
# 원본 Kafka 소비와 MongoDB 연결·배치 처리에 필요한 설정 예시를 제공한다.
RAW_SOURCE_ID=ticketguard-dev-generation-1
RAW_KAFKA_NETWORK=ticket-guard_default
RAW_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
RAW_KAFKA_TOPIC=ticketguard.events.v1
RAW_KAFKA_GROUP_ID=ticketguard-raw-db-v1
RAW_MONGO_DATABASE=ticketguard_raw
# Root authenticates in admin; writer authenticates in RAW_MONGO_DATABASE.
# These values create users only on a new, empty volume. Keep them stable afterward.
RAW_MONGO_ROOT_USERNAME=CHANGE_ME_ADMIN
RAW_MONGO_ROOT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
RAW_MONGO_WRITER_USERNAME=CHANGE_ME_WRITER
RAW_MONGO_WRITER_PASSWORD=CHANGE_ME_WRITER_PASSWORD
# Created together with writer on first boot; read only in RAW_MONGO_DATABASE.
RAW_MONGO_READER_USERNAME=raw_reader
RAW_MONGO_READER_PASSWORD=CHANGE_ME_READER_PASSWORD

# Direct raw routing; do not change routing policy for a live group.
RAW_BATCH_MAX_MESSAGES=200
RAW_BATCH_WAIT_SECONDS=1
RAW_BATCH_MAX_BYTES=4194304
RAW_BATCH_WRITE_SECONDS=35
RAW_ROUTING_FINGERPRINT=54e2a7c73316ed633ef5a445ff9dc0b87b44cd302b8af93f8c9cce586f6f8b1b
