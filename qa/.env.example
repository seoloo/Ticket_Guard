# 복사해서 .env로 쓰기 · .env는 Git 제외
# 시험 대상: fake(가짜) · live(실제)
TICKET_GUARD_QA_TARGET_KIND=fake

# 시스템(Django) 주소 · 컨테이너 안에서는 host.docker.internal
TICKET_GUARD_QA_SYSTEM_BASE_URL=http://127.0.0.1:8000
# 시스템 저장소 .env.example의 개발용 계정
TICKET_GUARD_QA_SYSTEM_USERNAME=ticketguard
TICKET_GUARD_QA_SYSTEM_PASSWORD=

# 시스템 MongoDB · 읽기 전용 계정만 · MongoDB 연결 후 사용
TICKET_GUARD_QA_SYSTEM_MONGO_URI=

# QA DB · 정답표 · 실행 기록
TICKET_GUARD_QA_QA_DATABASE_URL=sqlite:///./qa_data/qa.db
TICKET_GUARD_QA_REPORT_OUTPUT_DIR=./qa_data/reports

# 가짜 대상 실행 흉내 시간(초) · 03 화면 확인용 · 실제 QA 소요 시간에 맞춰 조정
TICKET_GUARD_QA_FAKE_RUN_DURATION_SEC=10

TICKET_GUARD_QA_DASHBOARD_HOST=127.0.0.1
# 안쪽 전용 포트 · 밖은 팀 입구 127.0.0.1:8000/qa/
TICKET_GUARD_QA_DASHBOARD_PORT=8800
# 혼자 개발: local_only · 빈 값 / 팀 입구 뒤: gateway_header · /qa
TICKET_GUARD_QA_ADMIN_CHECK_MODE=local_only
TICKET_GUARD_QA_DASHBOARD_BASE_PATH=
