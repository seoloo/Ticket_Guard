# 복사해서 .env로 쓰기 · .env는 Git 제외
# 시험 대상: fake(가짜) · live(실제)
TICKET_GUARD_QA_TARGET_KIND=fake

# 시스템(Django) 주소 · 컨테이너 안에서는 host.docker.internal
TICKET_GUARD_QA_SYSTEM_BASE_URL=http://127.0.0.1:8000
# 시스템 저장소 .env.example의 개발용 계정
TICKET_GUARD_QA_SYSTEM_USERNAME=ticketguard
TICKET_GUARD_QA_SYSTEM_PASSWORD=

# 시스템 테스트 훅과 같은 값 · 저장소 .env의 QA_TEST_ACCOUNT_COUNT · QA_TEST_ACCOUNT_PASSWORD · QA_CAPTCHA_FIXED_ANSWER
TICKET_GUARD_QA_TEST_ACCOUNT_COUNT=0
TICKET_GUARD_QA_TEST_ACCOUNT_PASSWORD=
TICKET_GUARD_QA_CAPTCHA_FIXED_ANSWER=
# 트래픽 전 시험 데이터 초기화 · 저장소 .env의 DEMO_ADMIN_USERNAME · DEMO_ADMIN_PASSWORD · 비우면 건너뜀
TICKET_GUARD_QA_SYSTEM_ADMIN_USERNAME=
TICKET_GUARD_QA_SYSTEM_ADMIN_PASSWORD=

# 이벤트 토픽 읽기 전용 · 기본 kafka:9092 (팀 compose 안) · 비우면 이벤트 전달 검증 건너뜀
TICKET_GUARD_QA_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
TICKET_GUARD_QA_KAFKA_EVENTS_TOPIC=ticketguard.events.v1

# 시스템 MongoDB · 읽기 전용 계정만 · MongoDB 연결 후 사용
TICKET_GUARD_QA_SYSTEM_MONGO_URI=

# QA DB · 정답표 · 실행 기록 · MongoDB QA 전용 인스턴스 · 팀 compose + qa/compose.qa-db.yml이면 qa-mongo:27017로 덮어씀
# 내 PC에서 직접 실행할 때만 · compose.qa-db.local.yml로 연 127.0.0.1:27021 · QA 계정
TICKET_GUARD_QA_QA_DATABASE_URL=mongodb://QA계정:비밀번호@127.0.0.1:27021/ticketguard_qa?authSource=ticketguard_qa
# QA DB 계정은 저장소 .env에 · qa/README.md · 비밀번호 영문 · 숫자만
# QA_MONGO_DATABASE=ticketguard_qa
# QA_MONGO_ROOT_USERNAME=
# QA_MONGO_ROOT_PASSWORD=
# QA_MONGO_USERNAME=
# QA_MONGO_PASSWORD=
# QA_MONGO_HOST_PORT=27021
TICKET_GUARD_QA_REPORT_OUTPUT_DIR=./qa_data/reports

# 가짜 대상 실행 흉내 시간(초) · 03 화면 확인용 · 실제 QA 소요 시간에 맞춰 조정
TICKET_GUARD_QA_FAKE_RUN_DURATION_SEC=10

# 팀 입구 127.0.0.1:8000 뒤의 주소 앞부분
TICKET_GUARD_QA_DASHBOARD_BASE_PATH=/qa
