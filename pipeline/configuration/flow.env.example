# 실제 자격 증명은 별도 무시되는 환경 파일에 작성한다.
# [홍석환] 사용자 흐름 실행 설정 예시
# 한 시간 보존은 코드 기본값이며 계정·네트워크 준비 후 별도 환경 파일에 실제 값을 넣는다.
SPARK_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EVENTS_TOPIC=ticketguard.events.v1
SPARK_KAFKA_GROUP_ID=ticketguard-spark-consumer
RAW_SOURCE_ID=설치된_원본_적재기와_같은_값
FLOW_RAW_MONGO_URI=mongodb://읽기계정:비밀번호@mongo-raw:27020/ticketguard_raw?authSource=ticketguard_raw
FLOW_TARGET_MONGO_URI=mongodb://지표쓰기계정:비밀번호@ticket-guard-workspace-db-mongo-1:27017/ticketguard_flow?authSource=ticketguard_flow
FLOW_TRIGGER_SECONDS=1
FLOW_PRESENCE_SECONDS=30
FLOW_GRACE_SECONDS=300
FLOW_MAX_EVENTS=250000
FLOW_CHECKPOINT_DIR=/checkpoints/flow-v1
FLOW_READ_TIMEOUT_MS=1000
FLOW_RAW_WAIT_SECONDS=10
SPARK_MAX_OFFSETS_PER_TRIGGER=1000
SPARK_KAFKA_NETWORK=ticket-guard_default
FLOW_RAW_NETWORK=ticket-guard-raw_raw-backend
SPARK_MONGO_NETWORK=ticket-guard-workspace-db_mongo-backend
# DB 준비 스크립트용. 관리자 읽기 URI는 기존 TICKET_GUARD_ADMIN_MONGO_URI를 사용한다.
FLOW_DATABASE=ticketguard_flow
FLOW_WRITER_USERNAME=설정할_지표쓰기계정
FLOW_WRITER_PASSWORD=설정할_쓰기비밀번호
FLOW_READER_USERNAME=설정할_지표읽기계정
FLOW_READER_PASSWORD=설정할_읽기비밀번호
FLOW_APPLY_SETUP=0
