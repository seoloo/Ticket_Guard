# 실제 자격 증명은 별도 무시되는 환경 파일에 작성한다.
SPARK_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EVENTS_TOPIC=ticketguard.events.v1
SPARK_KAFKA_GROUP_ID=ticketguard-spark-consumer
RAW_SOURCE_ID=설치된_원본_적재기와_같은_값
FLOW_RAW_MONGO_URI=mongodb://읽기계정:비밀번호@mongo-raw:27020/ticketguard_raw?authSource=ticketguard_raw
FLOW_TARGET_MONGO_URI=mongodb://지표쓰기계정:비밀번호@ticket-guard-workspace-db-mongo-1:27017/ticketguard_flow?authSource=ticketguard_flow
FLOW_TRIGGER_SECONDS=1
FLOW_PRESENCE_SECONDS=30
FLOW_GRACE_SECONDS=300
FLOW_MAX_EVENTS=250000
